# The same Postgres database as the Student Diary, Teacher App and Admin Panel (pooled URL on Neon).
# The website only reads public rows and writes applications. It never runs migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# This site's own address: used in emails, the sitemap and link previews
APP_URL="http://localhost:3002"
# Email through Resend. Leave empty in development: emails are written to ./.emails instead
RESEND_API_KEY=""
EMAIL_FROM="Online School <hello@yourschool.az>"
# Gets a notice for every new application (the school office)
ADMIN_NOTIFY_EMAIL=""
# Shown in the privacy notice as the contact for data questions
PRIVACY_CONTACT_EMAIL=""
# Lesson times on the site are shown in this timezone
SCHOOL_TIMEZONE="Asia/Baku"
# At least 32 random characters. Salts the hash of a visitor's address, which is used only to
# limit floods of applications. Not shared with the other apps.
APPLY_SALT=""
# The school's name and contacts. Placeholders are shown until these are set.
NEXT_PUBLIC_SCHOOL_NAME=""
CONTACT_PHONE=""
CONTACT_WHATSAPP=""
CONTACT_EMAIL=""
